---
import "@/styles/global.css";
import Remark42Counter from "@/components/Remark42Counter.astro";
import TagLink from "@/components/TagLink.astro";
import { getLangFromUrl } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const data = Astro.props;
const tags = data.tags;
---

<li class="post-card">
  <div class="post-link">
    <div class="post-text">
      <a href={data.url} class="post-title-link">
        <h2 class="post-title" transition:name={`post-title-${data.postId}`}>
          {data.title}
        </h2>
      </a>
      <a href={data.url} class="post-description">
        {data.description}
      </a>
      <div class="tags" transition:name={`post-tags-${data.postId}`}>
        {
          tags.map((tag: string) => (
            <TagLink tag={tag} lang={lang} />
          ))
        }
      </div>

      <div class="post-meta-row">
        <span class="post-date">{data.date}</span>
        <span class="post-stats">
          <span class="post-stat">
            💬 <Remark42Counter url={data.postPath} />
          </span>
        </span>
      </div>
    </div>

    <a href={data.url} class="post-image-link">
      <img
        src={data.img}
        alt={data.title}
        class="post-image"
        loading="lazy"
        transition:name={`post-image-${data.postId}`}
      />
    </a>
  </div>
</li>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin-top: 0.75rem;
    min-width: 0;
    font-size: 0.85rem;
  }

  .post-card {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-card + .post-card {
    margin-top: 2rem;
  }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
    text-decoration: none;
  }

  .post-text {
    flex: 1;
    min-width: 0;
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    line-height: 1.6;
  }

  .post-title-link {
    text-decoration: none;
    display: block;
    min-width: 0;
  }

  .post-title {
    margin: 0;
    font-family:
      "Noto Sans SC",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    font-weight: 500;
    font-size: 1.34rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-description {
    margin-top: 0.5rem;
    color: #4e5e6e;
    text-decoration: none;
    font-weight: 400;
    font-size: 0.95rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: #66717c;
  }

  .post-date {
    white-space: nowrap;
    line-height: 1.6;
  }

  .post-stats {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1.6;
    white-space: nowrap;
  }

  .post-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .post-image-link {
    display: block;
    flex: 0 0 11rem;
    width: 11rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .post-image {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  :global(.dark) .post-description {
    color: #c4ccd5;
  }

  :global(.dark) .post-meta-row {
    color: #aab7c4;
  }

  @media (max-width: 600px) {
    .post-link {
      display: grid;
      grid-template-columns: 1fr 145px;
      grid-template-areas:
        "title title"
        "desc image"
        "tags image"
        "meta image";
      column-gap: 0.75rem;
      row-gap: 0.2rem;
      align-items: start;
    }

    .post-text {
      display: contents;
      min-height: auto;
    }

    .post-title-link {
      grid-area: title;
    }

    .post-title {
      -webkit-line-clamp: 2;
    }

    .post-description {
      grid-area: desc;
    }

    .post-meta-row {
      grid-area: meta;
      gap: 0.7rem;
    }

    .post-image {
      grid-area: image;
      width: 100%;
      height: calc(145px * 10 / 16);
      align-self: center;
    }

    .post-image-link {
      grid-area: image;
      align-self: center;
      width: 145px;
      aspect-ratio: auto;
      overflow: visible;
      text-decoration: none;
    }

    .post-card {
      padding-bottom: 0.2rem;
      padding-top: 0.2rem;
    }
  }
</style>
